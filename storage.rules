rules_version = '2';

// Rules cho Firebase Storage — quyết định ai được đọc/ghi file (ảnh pet,
// ảnh vật phẩm...). Khác với firestore.rules (dữ liệu), file này quản lý
// riêng phần lưu trữ file nhị phân.
service firebase.storage {
  match /b/{bucket}/o {

    // Ảnh 40 mẫu pet (pets/pet_01.png ... pet_40.png) và ảnh vật phẩm
    // cửa hàng (items/...) — cho phép AI CŨNG XEM ĐƯỢC (kể cả chưa đăng
    // nhập) vì đây chỉ là tài nguyên hình ảnh công khai của app, không
    // phải dữ liệu riêng tư. Chỉ tài khoản đã đăng nhập mới được ghi/xóa.
    match /pets/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /items/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Mọi đường dẫn khác: mặc định khóa hết, chỉ người đã đăng nhập được
    // đọc/ghi (ví dụ ảnh đại diện học sinh sau này).
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
